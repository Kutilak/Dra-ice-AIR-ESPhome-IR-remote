# Copy this file to secrets.yaml and fill in real values before flashing.
# secrets.yaml is gitignored - never commit it.

wifi_ssid: "YOUR_WIFI_SSID"
wifi_password: "YOUR_WIFI_PASSWORD"

# Generate your own random key (base64, 32 bytes) - do not reuse this
# placeholder. The ESPHome dashboard can generate one for you with a
# button, or from a terminal:
#   python -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(32)).decode())"
encryption_key: "REPLACE_WITH_YOUR_OWN_GENERATED_KEY_BASE64_32_BYTES="

ota_password: "YOUR_OTA_PASSWORD"
